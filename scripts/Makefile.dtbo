
# SPDX-License-Identifier: GPL-2.0
# Directly disable dtbo.img output
# Do NOT generate dtbo.img

PHONY += dtbo_img
dtbo_img:
	@echo "========================================="
	@echo " DTBO image generation is DISABLED "
	@echo " No dtbo.img will be output "
	@echo "========================================="

# 清空所有 dtbo 编译目标
dtbo-y :=
dtbo-m :=
dtbo- :=

# 禁用 dtbo.img 生成规则
$(obj)/dtbo.img:
	@true

# 禁用所有 dtbo 编译
$(obj)/%.dtbo:
	@true

# 空规则，不执行任何动作
dtbo: dtbo_img
